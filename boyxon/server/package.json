{
  "name": "boyxon-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "tsx watch src/run-local.ts",
    "prebuild": "node scripts/ensure-client-build.cjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/utils/seed.ts",
    "test": "tsx src/utils/test-e2e.ts",
    "test:unit": "vitest run",
    "lint": "tsc --noEmit",
    "deploy:cf": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-cloudflare.ps1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.11.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^9.3.2",
    "pino-http": "^10.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.16.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.154.0"
  }
